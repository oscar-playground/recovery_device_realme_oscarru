# mount point       fstype  device                                              device2  flags
/boot               emmc    /dev/block/bootdevice/by-name/boot                             flags=display="Boot";backup;flashimg;slotselect
/vendor_boot        emmc    /dev/block/bootdevice/by-name/vendor_boot                      flags=display="Vendor Boot";backup;flashimg;slotselect
/dtbo               emmc    /dev/block/bootdevice/by-name/dtbo                             flags=display="DTBO";backup;flashimg;slotselect
/vbmeta             emmc    /dev/block/bootdevice/by-name/vbmeta                           flags=display="VBMeta";backup;flashimg;
/vbmeta_system      emmc    /dev/block/bootdevice/by-name/vbmeta_system                    flags=display="System VBMeta";backup;flashimg;
/vbmeta_vendor      emmc    /dev/block/bootdevice/by-name/vbmeta_vendor                    flags=display="Vendor VBMeta";backup;flashimg;
/ocdt               emmc    /dev/block/bootdevice/by-name/ocdt                             flags=display="OCDT";backup;flashimg;
